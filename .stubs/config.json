{
  "project_name": "stubs-project",
  "autonomy_level": "strict_gate",
  "paths": {
    "specs_dir": "src",
    "templates_dir": ".stubs/templates",
    "db_path": ".stubs/graph.sqlite"
  },
  "search": {
    "engine": "sqlite-fts5",
    "vector_plugin": null
  },
  "grill": {
    "default_depth": "standard_drill"
  },
  "architecture": {
    "min_domain_size": 2,
    "domains": {
      "autonomy": [
        "src/autonomy/**",
        "src/phase/**",
        "src/concept/**"
      ],
      "graph": [
        "src/graph/**",
        "src/query/**"
      ],
      "parser": [
        "src/parser/**",
        "src/compiler/**"
      ],
      "server": [
        "src/server/**",
        "src/web/**"
      ],
      "core": [
        "src/config/**",
        "src/context/**"
      ],
      "tools": [
        "src/lint/**",
        "src/prune/**",
        "src/mock/**",
        "src/changelog/**",
        "src/export/**",
        "src/templates/**",
        "src/diagram/**",
        "src/impact/**"
      ]
    }
  }
}
