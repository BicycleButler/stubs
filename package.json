{
  "name": "stubs",
  "version": "1.3.0",
  "description": "Unified central hub for AI Agent Skills, Rules, CLI, and MCP servers",
  "main": "packages/cli/dist/index.cjs",
  "bin": {
    "stubs": "bin/stubs.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "bin/",
    "packages/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:cli": "npm run build --workspace=@wiltermood/stubs",
    "build:core": "npm run build --workspace=@wiltermood/stubs-core",
    "test": "npm run test:tale && npm run test:core",
    "test:tale": "npm run test --workspace=@wiltermood/tale",
    "test:core": "npm run test --workspace=@wiltermood/stubs-core",
    "lint": "eslint packages/core/src packages/cli/src",
    "lint:tale": "node packages/tale/src/tale-lint.mjs packages/tale packages/cli",
    "format": "prettier --write .",
    "start": "node bin/stubs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiltermoodj/stubs.git"
  },
  "keywords": [
    "stubs",
    "skills",
    "tale",
    "design",
    "agent",
    "mcp",
    "architecture",
    "cli"
  ],
  "author": "Wiltermood",
  "license": "ISC",
  "dependencies": {
    "@wiltermood/design": "^1.0.0",
    "@wiltermood/stubs": "^1.3.0",
    "@wiltermood/stubs-core": "^1.2.4",
    "@wiltermood/tale": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0"
  }
}
