{
  "name": "@bicyclebutler/stubs-monorepo",
  "version": "1.4.3",
  "private": true,
  "description": "Unified central hub for AI Agent Skills, Rules, CLI, and MCP servers",
  "main": "packages/cli/dist/index.cjs",
  "bin": {
    "stubs": "bin/stubs.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "bin/",
    "packages/",
    ".agents/skills/stubs/",
    ".stubs/templates/",
    "README.md",
    "QUICKSTART.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:cli": "npm run build --workspace=@bicyclebutler/stubs",
    "build:core": "npm run build --workspace=@bicyclebutler/stubs-core",
    "test": "npm run test:tale && npm run test:cli && npm run test:core",
    "test:tale": "npm run test --workspace=@bicyclebutler/tale",
    "test:cli": "npm run test --workspace=@bicyclebutler/stubs",
    "test:core": "npm run test --workspace=@bicyclebutler/stubs-core",
    "lint": "eslint packages/core/src packages/cli/src",
    "tale": "node packages/tale/src/tale.mjs",
    "tale:fix": "node packages/tale/src/tale.mjs --fix",
    "lint:tale": "node packages/tale/src/tale.mjs",
    "lint:tale:all": "node packages/tale/src/tale.mjs",
    "format": "prettier --write .",
    "format:tale": "node packages/tale/src/tale.mjs --fix",
    "start": "node bin/stubs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BicycleButler/stubs.git"
  },
  "bugs": {
    "url": "https://github.com/BicycleButler/stubs/issues"
  },
  "homepage": "https://github.com/BicycleButler/stubs#readme",
  "keywords": [
    "stubs",
    "skills",
    "tale",
    "agent",
    "mcp",
    "architecture",
    "cli"
  ],
  "author": "BicycleButler",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0"
  }
}
